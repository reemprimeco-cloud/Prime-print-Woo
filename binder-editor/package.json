{
  "name": "binder-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prime Printing designer: the customer-facing editor (Fabric.js) and the print-only render route.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode print && vite build --mode editor",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:print": "vite build --mode print",
    "build:editor": "vite build --mode editor"
  },
  "dependencies": {
    "fabric": "^6.9.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
