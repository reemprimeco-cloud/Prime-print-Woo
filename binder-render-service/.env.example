# Required in production
BINDER_SECRET=            # long random string; the WordPress plugin sends it as X-Binder-Secret
ALLOWED_IMAGE_HOSTS=primekw.net,www.primekw.net,primeprint.com.kw          # hosts customer artwork may be fetched from (comma separated)
ALLOWED_CALLBACK_HOSTS=primekw.net,www.primekw.net,primeprint.com.kw       # hosts the async result may be POSTed to
PUBLIC_BASE_URL=https://binder-render.example.com   # how WordPress reaches this service (used in file links)

# Sizing: each render can use several hundred MB with a 300 dpi image
RENDER_CONCURRENCY=1
RENDER_MAX_QUEUE=20
RENDER_TIMEOUT_MS=120000

# Abuse protection (per session_token)
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=600000

# Paths (defaults are right for the Docker image)
# GS_BIN=/usr/bin/gs
# ICC_PROFILE=/app/assets/icc/FOGRA39.icc
# EDITOR_DIST=/app/editor-dist
# TEMPLATES_DIR=/app/templates
# OUTPUT_DIR=/data/output
# RETENTION_HOURS=24
# CHROMIUM_NO_SANDBOX=1     # needed when running as root in a container
# CHROMIUM_PATH=/usr/bin/chromium   # use a system Chromium instead of Playwright's download
# ENABLE_SAMPLES=1          # dev only: serves /samples and allows relative image paths
