{
  "name": "binder-render-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Renders a binder design JSON to a print-ready CMYK PDF: Playwright (Chromium) -> Ghostscript (FOGRA39) -> TrimBox/BleedBox.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.mjs",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs --external:playwright --external:express --external:pdf-lib --alias:@binder/shared=../binder-shared/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export-sample": "tsx scripts/export-sample.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "image-size": "^2.0.4",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
