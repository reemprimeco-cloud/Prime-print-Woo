  "narrative": {
    "northStar": "The Print Proof Sheet",
    "overview": "Prime's interface behaves like a proof pulled from the press: square edges, hairline rules, uppercase tracked labels and one small sky-blue square standing in for the dot of the 'i' in the logo. Precise, confident, warm and local.",
    "keyCharacteristics": [
      "Zero border radius except circular avatars and category medallions in the app.",
      "One signature motif: the 9px sky square.",
      "Light weights (200 to 400) set large.",
      "Hairline borders instead of fills.",
      "Real product photography fills cards.",
      "Same system on website and iOS app shell."
